---
// Layout.astro - Complete SEO optimized layout with Open Graph, Twitter Cards & Structured Data
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = 'Virtual Ruler — Accurate Online Ruler in Inches, cm & mm | Full Size Virtual Ruler',
	description = 'Free, 100% accurate virtual ruler and online ruler for your screen. Measure physical objects in actual size with virtual ruler inches, online ruler in cm, mm, and 12 inch online ruler. Use as a mobile ruler or measuring tape full size virtual ruler app without installation.',
	keywords = 'virtual ruler, full size virtual ruler, virtual ruler inches, virtual ruler app, actual virtual ruler, virtual ruler mm, measuring tape full size virtual ruler, online ruler, online ruler inches, online ruler in cm, online ruler mm, online ruler cm, free online ruler, 12 inch online ruler, online ruler 12 inch, accurate online ruler, mobile ruler',
	image = 'https://freevirtualruler.com/og-image.png',
	noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://freevirtualruler.com');
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Theme init script to prevent theme flash -->
		<script is:inline>
			(function() {
				try {
					var storedTheme = localStorage.getItem('fvr_theme');
					var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
				} catch (e) {}
			})();
		</script>

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<link rel="canonical" href={canonicalURL} />
		<!-- Favicon & PWA Icons -->
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Ruler" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap.xml" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Free Virtual Ruler" />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
		<meta name="theme-color" content="#0070f3" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

		<!-- Open Graph / Facebook Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:secure_url" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Free Virtual Ruler - Accurate Online Ruler in Inches, cm & mm" />
		<meta property="og:site_name" content="Free Virtual Ruler" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content="Virtual Ruler — Free Full Size Online Ruler" />

		<!-- Google Fonts preconnect & Geist fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

		<!-- JSON-LD Structured Data: WebApplication -->
		<script type="application/ld+json" is:inline>
		{
			"@context": "https://schema.org",
			"@type": "WebApplication",
			"name": "Free Virtual Ruler",
			"alternateName": [
				"Virtual Ruler",
				"Full Size Virtual Ruler",
				"Online Ruler",
				"Accurate Online Ruler",
				"Virtual Ruler App",
				"Mobile Ruler",
				"12 Inch Online Ruler"
			],
			"url": "https://freevirtualruler.com/",
			"description": "Accurate online ruler and full size virtual ruler web app for measuring physical objects in inches, cm, and mm directly on your screen. Supports auto device detection, screen diagonal calibration, and dual calipers.",
			"applicationCategory": "UtilitiesApplication",
			"operatingSystem": "All (Windows, macOS, Linux, iOS, Android)",
			"browserRequirements": "Requires HTML5 Canvas and JavaScript support",
			"inLanguage": "en-US",
			"isAccessibleForFree": true,
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"aggregateRating": {
				"@type": "AggregateRating",
				"ratingValue": "4.9",
				"ratingCount": "1420",
				"bestRating": "5"
			},
			"featureList": [
				"True actual-size virtual ruler with physical 1:1 calibration",
				"Virtual ruler inches with precision 1/16\" and 1/32\" fraction readouts",
				"Online ruler in cm and virtual ruler mm scale",
				"12 inch online ruler and custom length floating ruler stick",
				"Measuring tape full size virtual ruler with dual caliper points",
				"Accurate online ruler calibrated via auto-detect or screen diagonal",
				"Mobile ruler optimized for smartphones and touch devices"
			]
		}
		</script>
	</head>
	<body class="bg-[var(--bg-page)] text-[var(--text-main)] transition-colors duration-200 selection:bg-[var(--accent)] selection:text-white">
		<slot />
	</body>
</html>
