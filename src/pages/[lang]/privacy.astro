---
// src/pages/[lang]/privacy.astro - Localized Privacy Policy Page
import Layout from '../../layouts/Layout.astro';
import SubpageHeader from '../../components/SubpageHeader.astro';
import Footer from '../../components/Footer.astro';
import { languages, type SupportedLang, defaultLang } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as SupportedLang[])
    .filter((l) => l !== defaultLang)
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params as { lang: SupportedLang };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  lang={lang}
  title={`${t('nav.privacy')} — ${t('header.logo')} | freevirtualruler.com`}
  description={t('meta.description')}
>
  <SubpageHeader activePage="privacy" lang={lang} />

  <main class="relative z-10 bg-[var(--bg-page)] min-h-screen py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-10">
      
      <!-- Breadcrumb & Header -->
      <div class="space-y-4">
        <nav class="flex items-center gap-2 text-xs font-mono text-[var(--text-tertiary)]" aria-label="Breadcrumb">
          <a href={translatePath('/')} class="hover:text-[var(--accent)] transition-colors">{t('nav.ruler')}</a>
          <span>/</span>
          <span class="text-[var(--text-main)]">{t('nav.privacy')}</span>
        </nav>

        <div class="space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-card)] shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span class="mono-eyebrow text-[10px] text-[var(--text-tertiary)] uppercase tracking-wider">{t('nav.privacy')}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-main)]">
            {t('nav.privacy')} — {t('header.logo')}
          </h1>
          <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
            {t('footer.tagline')}
          </p>
        </div>
      </div>

      <!-- Privacy Card -->
      <div class="p-6 sm:p-8 rounded-[16px] bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[var(--shadow-whisper)] space-y-6 text-sm text-[var(--text-secondary)] leading-relaxed">
        <section class="space-y-2">
          <h2 class="text-lg font-semibold text-[var(--text-main)]">{t('privacy.section1_title')}</h2>
          <p>
            {t('privacy.section1_body')}
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-lg font-semibold text-[var(--text-main)]">{t('privacy.section2_title')}</h2>
          <p>
            {t('privacy.section2_body')}
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-lg font-semibold text-[var(--text-main)]">{t('privacy.section3_title')}</h2>
          <p>
            {t('privacy.section3_body')}
          </p>
        </section>
      </div>

    </div>
  </main>

  <Footer lang={lang} />
</Layout>
