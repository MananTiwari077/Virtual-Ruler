---
// src/pages/[lang]/contact.astro - Localized Contact Page
import Layout from '../../layouts/Layout.astro';
import SubpageHeader from '../../components/SubpageHeader.astro';
import Footer from '../../components/Footer.astro';
import { languages, type SupportedLang, defaultLang } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as SupportedLang[])
    .filter((l) => l !== defaultLang)
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params as { lang: SupportedLang };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  lang={lang}
  title={`${t('nav.contact')} — ${t('header.logo')} | freevirtualruler.com`}
  description={t('meta.description')}
>
  <SubpageHeader activePage="contact" lang={lang} />

  <main class="relative z-10 bg-[var(--bg-page)] min-h-screen py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-10">
      
      <!-- Breadcrumb & Header -->
      <div class="space-y-4">
        <nav class="flex items-center gap-2 text-xs font-mono text-[var(--text-tertiary)]" aria-label="Breadcrumb">
          <a href={translatePath('/')} class="hover:text-[var(--accent)] transition-colors">{t('nav.ruler')}</a>
          <span>/</span>
          <span class="text-[var(--text-main)]">{t('nav.contact')}</span>
        </nav>

        <div class="space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-card)] shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
            <span class="mono-eyebrow text-[10px] text-[var(--text-tertiary)] uppercase tracking-wider">{t('nav.contact')}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-main)]">
            {t('nav.contact')} — {t('header.logo')}
          </h1>
          <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
            {t('footer.tagline')}
          </p>
        </div>
      </div>

      <!-- Contact Message Card -->
      <div class="p-6 sm:p-8 rounded-[16px] bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[var(--shadow-whisper)] space-y-6">
        <h2 class="text-lg font-semibold text-[var(--text-main)]">
          {t('contact.form_title')}
        </h2>
        <form class="space-y-4" onsubmit={`event.preventDefault(); alert(${JSON.stringify(t('contact.success'))});`}>
          <div class="space-y-1.5">
            <label for="contact-name" class="block text-xs font-medium text-[var(--text-main)]">{t('contact.label_name')}</label>
            <input type="text" id="contact-name" required placeholder={t('contact.placeholder_name')} class="w-full px-3 py-2 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-page)] text-xs text-[var(--text-main)] focus:outline-none focus:border-[var(--accent)] transition-colors" />
          </div>
          <div class="space-y-1.5">
            <label for="contact-email" class="block text-xs font-medium text-[var(--text-main)]">{t('contact.label_email')}</label>
            <input type="email" id="contact-email" required placeholder={t('contact.placeholder_email')} class="w-full px-3 py-2 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-page)] text-xs text-[var(--text-main)] focus:outline-none focus:border-[var(--accent)] transition-colors" />
          </div>
          <div class="space-y-1.5">
            <label for="contact-message" class="block text-xs font-medium text-[var(--text-main)]">{t('contact.label_message')}</label>
            <textarea id="contact-message" rows="4" required placeholder={t('contact.placeholder_message')} class="w-full px-3 py-2 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-page)] text-xs text-[var(--text-main)] focus:outline-none focus:border-[var(--accent)] transition-colors"></textarea>
          </div>
          <button type="submit" class="px-5 py-2.5 rounded-[6px] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-white text-xs font-semibold shadow-xs transition-all">
            {t('contact.btn_send')}
          </button>
        </form>
      </div>

    </div>
  </main>

  <Footer lang={lang} />
</Layout>
