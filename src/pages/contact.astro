---
import Layout from '../layouts/Layout.astro';
import SubpageHeader from '../components/SubpageHeader.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us — Free Virtual Ruler | Feedback, Device Calibration & Support"
  description="Have questions or suggestions for Free Virtual Ruler? Submit device profiles, report bugs, request features, or get in touch with our team directly."
  keywords="contact virtual ruler, free virtual ruler support, report device ppi, feedback online ruler"
>
  <SubpageHeader activePage="contact" />

  <main class="relative z-10 bg-[var(--bg-page)] min-h-screen py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-10">
      
      <!-- Breadcrumb & Header -->
      <div class="space-y-4">
        <nav class="flex items-center gap-2 text-xs font-mono text-[var(--text-tertiary)]" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[var(--accent)] transition-colors">Home</a>
          <span>/</span>
          <span class="text-[var(--text-main)]">Contact Us</span>
        </nav>

        <div class="space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-card)] shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
            <span class="mono-eyebrow text-[10px] text-[var(--text-tertiary)] uppercase tracking-wider">Get in Touch</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-main)]">
            Contact & Feedback
          </h1>
          <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
            Have a question, device calibration suggestion, or feature request? We'd love to hear from you.
          </p>
        </div>
      </div>

      <!-- Contact Info Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 rounded-[12px] bg-[var(--bg-card)] border border-[var(--border-color)] space-y-2">
          <div class="w-7 h-7 rounded-[6px] bg-[var(--accent-light)] text-[var(--accent)] flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <h2 class="text-xs font-semibold text-[var(--text-main)]">Direct Email</h2>
          <a href="mailto:support@freevirtualruler.com" class="text-xs text-[var(--accent)] hover:underline block break-all font-mono">
            support@freevirtualruler.com
          </a>
        </div>

        <div class="p-4 rounded-[12px] bg-[var(--bg-card)] border border-[var(--border-color)] space-y-2">
          <div class="w-7 h-7 rounded-[6px] bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h2 class="text-xs font-semibold text-[var(--text-main)]">Response Time</h2>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            Replies typically within 24 to 48 hours.
          </p>
        </div>

        <div class="p-4 rounded-[12px] bg-[var(--bg-card)] border border-[var(--border-color)] space-y-2">
          <div class="w-7 h-7 rounded-[6px] bg-purple-500/10 text-purple-500 flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
            </svg>
          </div>
          <h2 class="text-xs font-semibold text-[var(--text-main)]">Device Profiles</h2>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            Send screen model specs to expand auto-detection.
          </p>
        </div>
      </div>

      <!-- Interactive Contact Form -->
      <div class="p-6 sm:p-8 rounded-[16px] bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[var(--shadow-whisper)] space-y-6">
        <div>
          <h2 class="text-lg sm:text-xl font-semibold text-[var(--text-main)]">Send Us a Message</h2>
          <p class="text-xs text-[var(--text-secondary)] mt-1">
            Fill out the form below and our team will get back to you promptly.
          </p>
        </div>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="contact-name" class="block text-xs font-semibold text-[var(--text-main)]">
                Your Name <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required 
                placeholder="Jane Doe"
                class="w-full px-3 py-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] focus:outline-none focus:border-[var(--accent)] focus:ring-1 focus:ring-[var(--accent)] transition-all"
              />
            </div>

            <div class="space-y-1.5">
              <label for="contact-email" class="block text-xs font-semibold text-[var(--text-main)]">
                Your Email <span class="text-red-500">*</span>
              </label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required 
                placeholder="jane@example.com"
                class="w-full px-3 py-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] focus:outline-none focus:border-[var(--accent)] focus:ring-1 focus:ring-[var(--accent)] transition-all"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="contact-topic" class="block text-xs font-semibold text-[var(--text-main)]">
              Topic <span class="text-red-500">*</span>
            </label>
            <select 
              id="contact-topic" 
              name="topic" 
              required
              class="w-full px-3 py-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] focus:outline-none focus:border-[var(--accent)] focus:ring-1 focus:ring-[var(--accent)] transition-all"
            >
              <option value="feedback">General Feedback & Suggestions</option>
              <option value="device_profile">Add New Device Profile / Calibration</option>
              <option value="bug_report">Bug Report / Display Issue</option>
              <option value="feature_request">Feature Request (Ruler / Caliper / Tools)</option>
              <option value="partnership">Business & Educational Inquiries</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="contact-message" class="block text-xs font-semibold text-[var(--text-main)]">
              Message <span class="text-red-500">*</span>
            </label>
            <textarea 
              id="contact-message" 
              name="message" 
              rows="5" 
              required 
              placeholder="Tell us what you think, describe the device specs, or suggest a new feature..."
              class="w-full px-3 py-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] focus:outline-none focus:border-[var(--accent)] focus:ring-1 focus:ring-[var(--accent)] transition-all resize-y"
            ></textarea>
          </div>

          <div class="flex items-center justify-between pt-2">
            <span class="text-[11px] text-[var(--text-tertiary)]">
              We never share your email with third parties.
            </span>
            <button 
              type="submit" 
              id="contact-submit-btn"
              class="px-5 py-2.5 rounded-[8px] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-white text-xs font-semibold shadow-xs transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center gap-1.5"
            >
              <span>Send Message</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>
        </form>

        <!-- Form Success State -->
        <div id="contact-success" class="hidden p-4 rounded-[10px] bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-xs sm:text-sm space-y-1">
          <div class="font-semibold flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
            Thank you! Your message has been sent successfully.
          </div>
          <p class="text-xs text-[var(--text-secondary)]">
            Our team will review your message and reply to your provided email address shortly.
          </p>
        </div>
      </div>

      <!-- FAQ Callout Card -->
      <div class="p-5 rounded-[12px] bg-[var(--bg-card)] border border-[var(--border-color)] flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <div class="text-xs font-semibold text-[var(--text-main)]">Looking for quick answers?</div>
          <div class="text-[11px] text-[var(--text-secondary)]">Check our comprehensive Frequently Asked Questions guide on the homepage.</div>
        </div>
        <a 
          href="/#faq" 
          class="px-3.5 py-1.5 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-xs font-medium text-[var(--text-main)] transition-colors shrink-0"
        >
          View FAQs &rarr;
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Simple, interactive form feedback
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBox = document.getElementById('contact-success');
  const submitBtn = document.getElementById('contact-submit-btn');

  if (form && successBox && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Visual feedback
      submitBtn.innerHTML = '<span>Sending...</span>';
      (submitBtn as HTMLButtonElement).disabled = true;

      setTimeout(() => {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
      }, 600);
    });
  }
</script>
