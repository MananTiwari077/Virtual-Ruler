---
import Layout from '../layouts/Layout.astro';
import SubpageHeader from '../components/SubpageHeader.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="500 — Internal Server Error | Free Virtual Ruler"
  description="An unexpected internal server error occurred. Please reload the page or return to the Free Virtual Ruler homepage."
  noindex={true}
>
  <SubpageHeader />

  <main class="relative z-10 bg-[var(--bg-page)] min-h-[75vh] flex items-center justify-center py-16 px-4 sm:px-6">
    
    <!-- Background glow -->
    <div class="absolute inset-0 hero-mesh-gradient pointer-events-none opacity-40"></div>

    <div class="max-w-lg w-full text-center space-y-8 relative z-10">
      
      <!-- Graphic Calibration / 500 Indicator -->
      <div class="mx-auto w-full max-w-[280px] p-4 rounded-[12px] bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[var(--shadow-whisper)] space-y-2">
        <div class="flex items-center justify-center gap-2">
          <div class="w-8 h-8 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <span class="font-mono font-bold text-lg text-[var(--text-main)]">Error 500</span>
        </div>
        <p class="text-[11px] font-mono text-[var(--text-tertiary)]">
          Signal interrupted · Server-side condition
        </p>
      </div>

      <!-- Text Header -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-amber-500/20 bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-mono font-medium shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          <span>Temporary Server Hiccup</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-main)]">
          Internal Server Error
        </h1>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed max-w-sm mx-auto">
          Something unexpected occurred while serving this resource. We're already looking into it. Please try refreshing or return to the main ruler.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button 
          onclick="window.location.reload()" 
          class="w-full sm:w-auto px-5 py-2.5 rounded-[8px] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-white text-xs font-semibold shadow-xs transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
            <path d="M16 21h5v-5"></path>
          </svg>
          <span>Reload Page</span>
        </button>
        <a 
          href="/" 
          class="w-full sm:w-auto px-5 py-2.5 rounded-[8px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-main)] text-xs font-medium text-[var(--text-secondary)] transition-all flex items-center justify-center"
        >
          Return to Virtual Ruler
        </a>
      </div>

      <!-- Diagnostics / Contact -->
      <div class="pt-6 border-t border-[var(--border-color)] text-xs text-[var(--text-secondary)]">
        <p>If this issue persists, please <a href="/contact" class="text-[var(--accent)] hover:underline font-medium">contact our team</a> with the details.</p>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
