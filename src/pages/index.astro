---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import RulerCanvas from '../components/RulerCanvas.astro';
import CalibrationModal from '../components/CalibrationModal.astro';
import ObjectPresetsModal from '../components/ObjectPresetsModal.astro';
import ShortcutsModal from '../components/ShortcutsModal.astro';
import SeoContent from '../components/SeoContent.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Virtual Ruler — Accurate Online Ruler in Inches, cm & mm | Full Size Virtual Ruler"
  description="Free, 100% accurate virtual ruler and online ruler for your screen. Measure objects in actual size with virtual ruler inches, online ruler in cm, mm, and 12 inch online ruler. Use as a mobile ruler or measuring tape full size virtual ruler app without installation."
>
  <!-- Global Vercel-style App Chrome Header -->
  <Header />

  <!-- Main Interactive Virtual Ruler Workspace -->
  <main id="main-content" class="relative">
    <RulerCanvas />
  </main>

  <!-- Comprehensive SEO Guide, Fraction Charts & FAQs (600+ words) -->
  <SeoContent />

  <!-- Footer -->
  <Footer />

  <!-- Modals & Overlays -->
  <CalibrationModal />
  <ObjectPresetsModal />
  <ShortcutsModal />
</Layout>
