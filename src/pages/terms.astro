---
import Layout from "../layouts/Layout.astro";
import SubpageHeader from "../components/SubpageHeader.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Terms & Conditions — Free Virtual Ruler | Service Terms & Accuracy Disclaimers"
  description="Review the Terms and Conditions of Free Virtual Ruler. Understand permissible usage, measurement accuracy expectations, and legal guidelines for our online ruler tool."
  keywords="virtual ruler terms and conditions, free virtual ruler terms of service, online ruler disclaimer"
>
  <SubpageHeader activePage="terms" />

  <main class="relative z-10 bg-[var(--bg-page)] min-h-screen py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-10">
      <!-- Breadcrumb & Header -->
      <div class="space-y-4">
        <nav
          class="flex items-center gap-2 text-xs font-mono text-[var(--text-tertiary)]"
          aria-label="Breadcrumb"
        >
          <a href="/" class="hover:text-[var(--accent)] transition-colors"
            >Home</a
          >
          <span>/</span>
          <span class="text-[var(--text-main)]">Terms & Conditions</span>
        </nav>

        <div class="space-y-2">
          <div
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-card)] shadow-xs"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
            <span
              class="mono-eyebrow text-[10px] text-[var(--text-tertiary)] uppercase tracking-wider"
              >User Agreement</span
            >
          </div>
          <h1
            class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-main)]"
          >
            Terms & Conditions
          </h1>
          <p class="text-xs sm:text-sm font-mono text-[var(--text-tertiary)]">
            Last Updated: September 9, 2026
          </p>
        </div>
      </div>

      <!-- Section 1 -->
      <section class="space-y-3">
        <h2
          class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text-main)]"
        >
          1. Agreement to Terms
        </h2>
        <p
          class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed"
        >
          By accessing or using Free Virtual Ruler (available at <strong
            >freevirtualruler.com</strong
          >), you acknowledge that you have read, understood, and agreed to be
          bound by these Terms and Conditions. If you do not agree with any part
          of these terms, please discontinue use of the website immediately.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3">
        <h2
          class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text-main)]"
        >
          2. Nature of Service and Permitted Use
        </h2>
        <p
          class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed"
        >
          Free Virtual Ruler provides web-based measurement utilities,
          interactive calipers, floating rulers, and unit conversion
          calculators. You are granted a revocable, non-exclusive,
          non-transferable license to access and use the service for:
        </p>
        <ul
          class="list-disc list-inside space-y-1.5 pl-2 text-xs sm:text-sm text-[var(--text-secondary)]"
        >
          <li>Personal, hobbyist, educational, and reference measurements</li>
          <li>
            Commercial product sizing checks, web design sizing, and prototyping
          </li>
          <li>Demonstrations in academic, craft, and maker environments</li>
        </ul>
      </section>

      <!-- Section 3 - Measurement Accuracy Disclaimer -->
      <section class="space-y-3">
        <h2
          class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text-main)]"
        >
          3. Accuracy Disclaimer & Calibration Responsibility
        </h2>
        <div
          class="p-4 rounded-[10px] bg-amber-500/10 border border-amber-500/20 text-xs sm:text-sm text-[var(--text-main)] space-y-2 leading-relaxed"
        >
          <p class="font-semibold text-amber-700 dark:text-amber-400">
            Important Notice Regarding Physical Precision:
          </p>
          <p>
            While Free Virtual Ruler employs advanced display metrics,
            Pythagoras screen diagonal math, and standardized credit card sizing
            guides to reproduce true physical scale, <strong
              >on-screen measurements are inherently dependent on the user's
              calibration accuracy, display zoom level, operating system DPI
              scaling, and hardware panel tolerances</strong
            >.
          </p>
          <p>
            This website is intended as a practical reference and convenience
            tool. It is <strong>NOT</strong> certified for life-critical, aerospace,
            high-voltage electrical, medical surgical, or structural engineering applications
            that require NIST-calibrated physical measurement instruments. You assume
            full responsibility for validating critical dimensions with certified
            physical tools.
          </p>
        </div>
      </section>

      <!-- Section 4 -->
      <section class="space-y-3">
        <h2
          class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text-main)]"
        >
          4. Intellectual Property Rights
        </h2>
        <p
          class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed"
        >
          The code, user interface, brand assets, logos, visual designs, graphic
          rulers, and interactive canvas components comprising Free Virtual
          Ruler are protected under applicable copyright, trademark, and
          intellectual property laws. You may not mirror, clone, scrape, or
          distribute the codebase without prior written consent.
        </p>
      </section>

      <!-- Section 5 -->
      <section class="space-y-3">
        <h2
          class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text-main)]"
        >
          5. Prohibited Conduct
        </h2>
        <p
          class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed"
        >
          When using Free Virtual Ruler, you agree not to:
        </p>
        <ul
          class="list-disc list-inside space-y-1.5 pl-2 text-xs sm:text-sm text-[var(--text-secondary)]"
        >
          <li>
            Attempt to compromise the security, integrity, or availability of
            our servers
          </li>
          <li>
            Deploy automated bots, spiders, or scrapers in a manner that strains
            infrastructure
          </li>
          <li>
            Frame or embed the service within an ad-stuffed proxy iframe without
            attribution
          </li>
          <li>
            Engage in any unlawful, harmful, or abusive behavior via our contact
            channels
          </li>
        </ul>
      </section>

      <!-- Section 6 -->
      <section class="space-y-3">
        <h2
          class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text-main)]"
        >
          6. Disclaimer of Warranties & Limitation of Liability
        </h2>
        <p
          class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed"
        >
          Free Virtual Ruler is provided on an <strong>"AS IS"</strong> and <strong
            >"AS AVAILABLE"</strong
          > basis without warranties of any kind, whether express or implied. Under
          no circumstances shall Free Virtual Ruler, its operators, or contributors
          be liable for any indirect, incidental, consequential, or punitive damages
          arising from the use or inability to use this service, or any inaccuracies
          in measurements obtained through the tool.
        </p>
      </section>

      <!-- Section 7 -->
      <section class="space-y-3">
        <h2
          class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text-main)]"
        >
          7. Modifications to Terms
        </h2>
        <p
          class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed"
        >
          We reserve the right to revise or replace these Terms and Conditions
          at our sole discretion. Any changes will be posted to this page with
          an updated revision date. Continued usage of the site constitutes your
          agreement to the updated terms.
        </p>
      </section>

      <!-- Section 8 -->
      <section class="space-y-3">
        <h2
          class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text-main)]"
        >
          8. Contact Information
        </h2>
        <p
          class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed"
        >
          For any legal or contractual inquiries concerning these Terms, please
          contact:
        </p>
        <div
          class="p-4 rounded-[8px] bg-[var(--bg-card)] border border-[var(--border-color)] font-mono text-xs text-[var(--text-main)]"
        >
          Email: <a
            href="mailto:legal@freevirtualruler.com"
            class="text-[var(--accent)] hover:underline"
            >legal@freevirtualruler.com</a
          >
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
