---
// SubpageHeader.astro - Unified top navigation for content subpages — mobile-first
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import type { SupportedLang } from '../i18n/ui';

interface Props {
  activePage?: 'about' | 'privacy' | 'terms' | 'contact';
  lang?: SupportedLang;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
const { activePage } = Astro.props;
---

<header class="sticky top-0 z-50 bg-[var(--bg-page)]/95 backdrop-blur-md border-b border-[var(--border-color)] transition-colors duration-200">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-2">
    
    <!-- Left: Logo -->
    <a href={translatePath('/')} class="flex items-center gap-2 group text-[var(--text-main)] hover:opacity-90 transition-opacity shrink-0" aria-label={t('header.logo')}>
      <div class="w-7 h-7 rounded-[6px] bg-[var(--accent)] text-white flex items-center justify-center shrink-0 shadow-xs group-hover:scale-105 transition-transform">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path>
          <path d="m14.5 12.5 2-2"></path>
          <path d="m11.5 9.5 2-2"></path>
          <path d="m8.5 6.5 2-2"></path>
          <path d="m17.5 15.5 2-2"></path>
        </svg>
      </div>
      <span class="font-semibold text-sm tracking-tight text-[var(--text-main)] hidden min-[360px]:block">
        {t('header.logo_short')}
      </span>
    </a>

    <!-- Desktop Center Nav (>= md) -->
    <nav class="hidden md:flex items-center gap-5 text-xs font-medium text-[var(--text-secondary)] flex-1 justify-center" aria-label={t('mobile.nav_label')}>
      <a href={translatePath('/')} class="hover:text-[var(--accent)] transition-colors flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path>
        </svg>
        <span>{t('nav.ruler')}</span>
      </a>
      <a href={translatePath('/about')} class={`hover:text-[var(--text-main)] transition-colors ${activePage === 'about' ? 'text-[var(--accent)] font-semibold' : ''}`}>
        {t('nav.about')}
      </a>
      <a href={translatePath('/contact')} class={`hover:text-[var(--text-main)] transition-colors ${activePage === 'contact' ? 'text-[var(--accent)] font-semibold' : ''}`}>
        {t('nav.contact')}
      </a>
      <a href={translatePath('/privacy')} class={`hover:text-[var(--text-main)] transition-colors ${activePage === 'privacy' ? 'text-[var(--accent)] font-semibold' : ''}`}>
        {t('nav.privacy')}
      </a>
      <a href={translatePath('/terms')} class={`hover:text-[var(--text-main)] transition-colors ${activePage === 'terms' ? 'text-[var(--accent)] font-semibold' : ''}`}>
        {t('nav.terms')}
      </a>
    </nav>

    <!-- Right: Actions -->
    <div class="flex items-center gap-1.5 shrink-0">
      <!-- Language Picker (always visible) -->
      <LanguagePicker variant="header" currentLang={currentLang} />

      <!-- Theme Toggle -->
      <button
        id="subpage-theme-toggle"
        class="h-8 w-8 flex items-center justify-center rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-main)] transition-all"
        title="Toggle Theme"
        aria-label="Toggle Theme"
      >
        <svg id="theme-sun-icon" class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg id="theme-moon-icon" class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Open Ruler CTA (desktop) -->
      <a
        href={translatePath('/')}
        class="h-8 px-3 rounded-[6px] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-white text-xs font-semibold hidden sm:flex items-center gap-1.5 shadow-xs transition-all hover:scale-[1.02] active:scale-[0.98]"
      >
        <span>{t('nav.open_ruler')}</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <!-- Hamburger (mobile only, < md) -->
      <button
        id="subpage-mobile-menu-btn"
        class="md:hidden h-8 w-8 flex items-center justify-center rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-main)] transition-all"
        aria-label={t('mobile.menu_open')}
        aria-expanded="false"
        aria-controls="subpage-mobile-nav"
      >
        <!-- Hamburger icon -->
        <svg id="hamburger-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <!-- Close icon (hidden by default) -->
        <svg id="close-menu-icon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Panel (hidden by default, slides in on mobile) -->
  <div
    id="subpage-mobile-nav"
    class="md:hidden hidden border-t border-[var(--border-color)] bg-[var(--bg-page)] overflow-hidden transition-all duration-200"
    role="navigation"
    aria-label={t('mobile.nav_label')}
  >
    <div class="px-4 py-3 space-y-1">
      <!-- Open Ruler CTA -->
      <a
        href={translatePath('/')}
        class="flex items-center justify-between px-3 py-2.5 rounded-[8px] bg-[var(--accent)] text-white text-sm font-semibold shadow-xs transition-all mb-3"
      >
        <span>{t('nav.open_ruler')}</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <!-- Nav links -->
      {[
        { path: '/', label: t('nav.ruler'), page: 'ruler' },
        { path: '/about', label: t('nav.about'), page: 'about' },
        { path: '/contact', label: t('nav.contact'), page: 'contact' },
        { path: '/privacy', label: t('nav.privacy'), page: 'privacy' },
        { path: '/terms', label: t('nav.terms'), page: 'terms' },
      ].map(({ path, label, page }) => (
        <a
          href={translatePath(path)}
          class={`flex items-center px-3 py-2.5 rounded-[8px] text-sm font-medium transition-colors ${
            activePage === page
              ? 'bg-[var(--accent-light)] text-[var(--accent)] font-semibold'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)]'
          }`}
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  // Theme toggle
  const themeBtn = document.getElementById('subpage-theme-toggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('fvr_theme', isDark ? 'dark' : 'light');
    });
  }

  // Mobile hamburger menu
  const menuBtn = document.getElementById('subpage-mobile-menu-btn');
  const mobileNav = document.getElementById('subpage-mobile-nav');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-menu-icon');

  if (menuBtn && mobileNav) {
    menuBtn.addEventListener('click', () => {
      const isOpen = !mobileNav.classList.contains('hidden');
      if (isOpen) {
        mobileNav.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      } else {
        mobileNav.classList.remove('hidden');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      const header = menuBtn.closest('header');
      if (header && !header.contains(e.target as Node)) {
        mobileNav.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
