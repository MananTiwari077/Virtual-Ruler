---
// CalibrationModal.astro - Methods: Auto-detect, Device Manual Selection, Screen Diagonal, Credit Card, Custom PPI
import { KNOWN_DEVICES, DEVICE_CATEGORIES } from '../utils/calibration';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { SupportedLang } from '../i18n/ui';

interface Props {
  lang?: SupportedLang;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<div
  id="calibration-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cal-modal-title"
>
  <div class="relative w-full max-w-lg bg-[var(--bg-card)] border border-[var(--border-color)] rounded-[12px] shadow-[var(--shadow-floating)] overflow-hidden transition-transform duration-200 scale-95 flex flex-col max-h-[90vh]">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-5 pt-5 pb-3 border-b border-[var(--border-color)] shrink-0">
      <div>
        <div class="mono-eyebrow text-[10px] text-[var(--text-tertiary)] uppercase mb-0.5">{t('cal.modal_eyebrow')}</div>
        <h2 id="cal-modal-title" class="text-base font-semibold tracking-tight text-[var(--text-main)]">
          {t('cal.modal_title')}
        </h2>
      </div>
      <button
        id="close-calibration-btn"
        class="w-7 h-7 flex items-center justify-center rounded-[6px] text-[var(--text-tertiary)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition-colors"
        aria-label="Close Calibration Modal"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Calibration Navigation Tabs -->
    <div class="flex items-center gap-1 p-2 px-4 sm:px-5 bg-[var(--bg-subtle)] border-b border-[var(--border-color)] shrink-0 overflow-x-auto no-scrollbar">
      <button
        data-cal-tab="auto"
        class="cal-tab-btn whitespace-nowrap py-1.5 px-3 rounded-[6px] text-xs font-medium transition-all bg-[var(--bg-card)] text-[var(--text-main)] shadow-sm"
      >
        {t('cal.tab_auto')}
      </button>
      <button
        data-cal-tab="device"
        class="cal-tab-btn whitespace-nowrap py-1.5 px-3 rounded-[6px] text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-main)] transition-all"
      >
        {t('cal.tab_device')}
      </button>
      <button
        data-cal-tab="diagonal"
        class="cal-tab-btn whitespace-nowrap py-1.5 px-3 rounded-[6px] text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-main)] transition-all"
      >
        {t('cal.tab_diagonal')}
      </button>
      <button
        data-cal-tab="card"
        class="cal-tab-btn whitespace-nowrap py-1.5 px-3 rounded-[6px] text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-main)] transition-all"
      >
        {t('cal.tab_card')}
      </button>
      <button
        data-cal-tab="manual"
        class="cal-tab-btn whitespace-nowrap py-1.5 px-3 rounded-[6px] text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-main)] transition-all"
      >
        {t('cal.tab_custom')}
      </button>
    </div>

    <!-- Modal Content Panels -->
    <div class="p-4 sm:p-5 overflow-y-auto space-y-4">
      
      <!-- Panel 1: Method 1 - Auto-Detect Devices -->
      <div id="cal-panel-auto" class="cal-panel space-y-4">
        <div class="p-4 rounded-[8px] border border-[var(--border-color)] bg-[var(--bg-subtle)]">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-[6px] bg-[#0070f3]/10 text-[#0070f3] flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="14" x="2" y="3" rx="2"></rect>
                <line x1="8" x2="16" y1="21" y2="21"></line>
                <line x1="12" x2="12" y1="17" y2="21"></line>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-[13px] font-semibold text-[var(--text-main)]" id="auto-device-name">
                Scanning hardware...
              </div>
              <div class="text-xs text-[var(--text-secondary)] font-mono mt-0.5" id="auto-device-specs">
                Detecting screen resolution & pixel density...
              </div>
              <div class="mt-2 inline-flex items-center gap-1.5 text-[11px] font-mono px-2 py-0.5 rounded-[4px] bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--text-secondary)]" id="auto-detected-ppi">
                Calculated: — CSS PPI
              </div>
            </div>
          </div>
        </div>

        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          <strong>Auto-Detect</strong> inspects your screen resolution, OS pixel scaling (<span class="font-mono">devicePixelRatio</span>), and hardware profile to apply exact factory specifications.
        </p>

        <button
          id="btn-apply-auto"
          class="w-full h-9 rounded-[6px] bg-[var(--accent)] text-white text-xs font-semibold hover:bg-[var(--accent-hover)] transition-colors shadow-sm flex items-center justify-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Apply Auto-Detected Calibration
        </button>
      </div>

      <!-- Panel 2: Manual Device Selection -->
      <div id="cal-panel-device" class="cal-panel space-y-3 hidden">
        <p class="text-xs text-[var(--text-secondary)]">
          Select your device model from the factory catalog below to load its exact PPI specification:
        </p>

        <!-- Search Input -->
        <div class="relative">
          <input
            type="text"
            id="device-search-input"
            placeholder="Search e.g. iPhone 15, MacBook 14, Dell XPS, 27 1440p..."
            class="w-full h-8 pl-8 pr-3 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] text-xs text-[var(--text-main)] focus:outline-none focus:border-[#0070f3] transition-colors"
          />
          <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-[var(--text-tertiary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>

        <!-- Category Filter Chips -->
        <div class="flex items-center gap-1 overflow-x-auto pb-1 no-scrollbar text-[11px]">
          {DEVICE_CATEGORIES.map(cat => (
            <button
              type="button"
              class="device-cat-filter px-2.5 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-main)] font-medium shrink-0 transition-colors"
              data-category={cat.id}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- Devices List -->
        <div id="devices-scroll-list" class="max-h-60 overflow-y-auto space-y-1.5 pr-1 border border-[var(--border-color)] rounded-[8px] p-2 bg-[var(--bg-subtle)]">
          {KNOWN_DEVICES.map(dev => (
            <button
              type="button"
              class="device-select-item w-full p-2.5 rounded-[6px] bg-[var(--bg-card)] border border-[var(--border-color)] hover:border-[#0070f3] hover:shadow-xs transition-all text-left flex items-center justify-between gap-2"
              data-dev-id={dev.id}
              data-dev-name={dev.name}
              data-dev-category={dev.category}
              data-dev-ppi={dev.physicalPpi}
              data-dev-dpr={dev.dpr || 1}
              data-dev-diagonal={dev.diagonal || 0}
            >
              <div class="min-w-0 flex-1">
                <div class="text-xs font-semibold text-[var(--text-main)] truncate">{dev.name}</div>
                <div class="text-[10px] text-[var(--text-tertiary)] font-mono mt-0.5">
                  Category: {dev.category.toUpperCase()} {dev.diagonal ? `· ${dev.diagonal}"` : ''}
                </div>
              </div>
              <div class="text-right shrink-0 font-mono">
                <div class="text-xs font-bold text-[#0070f3]">{dev.physicalPpi} PPI</div>
                <div class="text-[10px] text-[var(--text-tertiary)]">Factory</div>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Panel 3: Method 2 - Screen Diagonal (Inches) -->
      <div id="cal-panel-diagonal" class="cal-panel space-y-4 hidden">
        <div>
          <label for="diagonal-input" class="block text-xs font-semibold text-[var(--text-main)] mb-1.5">
            Enter Physical Screen Diagonal (inches):
          </label>
          <div class="flex gap-2">
            <input
              type="number"
              id="diagonal-input"
              step="0.1"
              min="4"
              max="100"
              placeholder="e.g. 15.6"
              class="flex-1 h-9 px-3 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] text-xs text-[var(--text-main)] focus:outline-none focus:border-[#0070f3] font-mono transition-colors"
            />
            <button
              id="btn-apply-diagonal"
              class="h-9 px-4 rounded-[6px] bg-[var(--accent)] text-white text-xs font-semibold hover:bg-[var(--accent-hover)] transition-colors shrink-0"
            >
              Apply Diagonal
            </button>
          </div>
        </div>

        <!-- Quick Diagonal Presets -->
        <div>
          <div class="text-[11px] font-medium text-[var(--text-tertiary)] mb-2">Common Screen Sizes:</div>
          <div class="grid grid-cols-3 sm:grid-cols-4 gap-1.5">
            <button type="button" class="diagonal-chip h-7 px-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] hover:bg-[var(--border-color)] text-[var(--text-secondary)] font-mono transition-all" data-diag="13.3">13.3" Laptop</button>
            <button type="button" class="diagonal-chip h-7 px-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] hover:bg-[var(--border-color)] text-[var(--text-secondary)] font-mono transition-all" data-diag="14.0">14.0" Laptop</button>
            <button type="button" class="diagonal-chip h-7 px-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] hover:bg-[var(--border-color)] text-[var(--text-secondary)] font-mono transition-all" data-diag="15.6">15.6" Laptop</button>
            <button type="button" class="diagonal-chip h-7 px-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] hover:bg-[var(--border-color)] text-[var(--text-secondary)] font-mono transition-all" data-diag="16.0">16.0" Laptop</button>
            <button type="button" class="diagonal-chip h-7 px-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] hover:bg-[var(--border-color)] text-[var(--text-secondary)] font-mono transition-all" data-diag="24.0">24" Monitor</button>
            <button type="button" class="diagonal-chip h-7 px-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] hover:bg-[var(--border-color)] text-[var(--text-secondary)] font-mono transition-all" data-diag="27.0">27" Monitor</button>
            <button type="button" class="diagonal-chip h-7 px-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] hover:bg-[var(--border-color)] text-[var(--text-secondary)] font-mono transition-all" data-diag="32.0">32" Monitor</button>
            <button type="button" class="diagonal-chip h-7 px-2 text-xs rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)] hover:bg-[var(--border-color)] text-[var(--text-secondary)] font-mono transition-all" data-diag="34.0">34" Ultrawide</button>
          </div>
        </div>

        <div class="p-3 rounded-[6px] bg-[var(--bg-subtle)] text-[11px] text-[var(--text-secondary)] space-y-1 font-mono">
          <div class="flex justify-between">
            <span>Viewport CSS Resolution:</span>
            <span id="diag-preview-res" class="text-[var(--text-main)] font-semibold">—</span>
          </div>
          <div class="flex justify-between">
            <span>Calculated CSS PPI:</span>
            <span id="diag-preview-ppi" class="text-[var(--text-main)] font-semibold">—</span>
          </div>
        </div>

        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          <strong>Method 2: Screen Diagonal</strong> uses the Pythagorean theorem (<span class="font-mono">√(W² + H²) / Diagonal</span>) to yield 100% mathematical accuracy on any laptop, monitor, or TV screen.
        </p>
      </div>

      <!-- Panel 4: Bonus Method - Credit Card Calibration -->
      <div id="cal-panel-card" class="cal-panel space-y-4 hidden">
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          Standard credit cards, driver's licenses, and ID cards have a globally standardized width of exactly <strong>85.60 mm (3.370 inches)</strong>. Hold your physical card against the screen and adjust the slider until the box matches.
        </p>

        <!-- Card Alignment Preview Box -->
        <div class="flex justify-center py-2">
          <div
            id="card-calibrate-box"
            class="rounded-[8px] border-2 border-[#0070f3] bg-[#0070f3]/5 shadow-md flex flex-col items-center justify-center p-2 text-center transition-[width,height] duration-75 select-none"
            style="width: 323px; height: 204px;"
          >
            <div class="text-xs font-semibold text-[var(--text-main)]">Physical Card Size</div>
            <div class="text-[10px] text-[var(--text-tertiary)] font-mono mt-0.5">85.60 mm × 53.98 mm</div>
            <div class="text-[10px] text-[#0070f3] font-mono mt-1 font-semibold">3.370" × 2.125"</div>
          </div>
        </div>

        <!-- Slider & Fine Tuning -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-[var(--text-secondary)]">Scale Factor:</span>
            <span id="card-slider-ppi" class="font-mono font-semibold text-[var(--text-main)]">96.0 PPI</span>
          </div>
          <input
            type="range"
            id="card-scale-slider"
            min="60"
            max="260"
            step="0.2"
            value="96"
            class="w-full"
          />
          <div class="flex justify-between text-[10px] text-[var(--text-tertiary)] font-mono">
            <span>60 PPI</span>
            <span>Use arrow keys for 0.2px precision</span>
            <span>260 PPI</span>
          </div>
        </div>

        <button
          id="btn-apply-card"
          class="w-full h-9 rounded-[6px] bg-[var(--accent)] text-white text-xs font-semibold hover:bg-[var(--accent-hover)] transition-colors shadow-sm"
        >
          Apply Credit Card Calibration
        </button>
      </div>

      <!-- Panel 5: Manual Custom PPI Direct Entry -->
      <div id="cal-panel-manual" class="cal-panel space-y-4 hidden">
        <div>
          <label for="manual-ppi-input" class="block text-xs font-semibold text-[var(--text-main)] mb-1.5">
            Enter Exact CSS PPI Value:
          </label>
          <div class="flex gap-2">
            <input
              type="number"
              id="manual-ppi-input"
              step="0.1"
              min="40"
              max="600"
              placeholder="e.g. 141.2"
              class="flex-1 h-9 px-3 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] text-xs text-[var(--text-main)] focus:outline-none focus:border-[#0070f3] font-mono transition-colors"
            />
            <button
              id="btn-apply-manual-ppi"
              class="h-9 px-4 rounded-[6px] bg-[var(--accent)] text-white text-xs font-semibold hover:bg-[var(--accent-hover)] transition-colors shrink-0"
            >
              Apply PPI
            </button>
          </div>
        </div>

        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          If you already know your display's CSS PPI or calibrated it with high-precision calipers, you can enter the value directly. Standard web is 96.0 CSS PPI.
        </p>
      </div>

    </div>

    <!-- Modal Footer Status -->
    <div class="p-3 px-4 sm:px-5 bg-[var(--bg-subtle)] border-t border-[var(--border-color)] flex items-center justify-between text-[11px] text-[var(--text-secondary)] shrink-0">
      <div class="flex items-center gap-1.5 min-w-0">
        <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0" id="current-cal-indicator"></span>
        <span id="current-cal-text" class="truncate">Current: 96.0 CSS PPI (Uncalibrated)</span>
      </div>
      <button
        id="btn-reset-cal"
        class="text-[11px] text-[var(--text-tertiary)] hover:text-red-500 underline transition-colors shrink-0 ml-2"
      >
        Reset Default
      </button>
    </div>

  </div>
</div>
