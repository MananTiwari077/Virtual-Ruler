---
// Header.astro - Mobile-optimized responsive ruler toolbar
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import type { SupportedLang } from '../i18n/ui';

interface Props {
  lang?: SupportedLang;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 bg-[var(--bg-page)]/95 backdrop-blur-md border-b border-[var(--border-color)] transition-colors duration-200 select-none">
  
  <!-- Primary Row (Height: 48px) -->
  <div class="px-2.5 sm:px-4 h-12 flex items-center justify-between gap-2 max-w-full">
    
    <!-- Left: Logo -->
    <div class="flex items-center gap-1.5 shrink-0">
      <a href={translatePath('/')} class="flex items-center gap-1.5 text-[var(--text-main)] hover:opacity-80 transition-opacity" aria-label={t('header.logo')}>
        <div class="w-7 h-7 rounded-[6px] bg-[var(--accent)] text-white flex items-center justify-center shrink-0 shadow-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path>
            <path d="m14.5 12.5 2-2"></path>
            <path d="m11.5 9.5 2-2"></path>
            <path d="m8.5 6.5 2-2"></path>
            <path d="m17.5 15.5 2-2"></path>
          </svg>
        </div>
        <span class="font-semibold text-xs sm:text-[13px] tracking-tight text-[var(--text-main)]">
          <span class="inline sm:hidden max-w-[85px] min-[390px]:max-w-[120px] truncate">{t('header.logo_short')}</span>
          <span class="hidden sm:inline">{t('header.logo')}</span>
        </span>
      </a>
    </div>

    <!-- Desktop Center Controls (>= md) -->
    <div class="hidden md:flex items-center gap-1.5 flex-1 justify-center" role="group" aria-label="Ruler Controls">
      <!-- Edge Toggles -->
      <div class="flex items-center gap-0.5 p-0.5 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-subtle)]">
        <button id="edge-top-btn" data-edge="top"
          class="edge-btn h-7 px-2.5 flex items-center rounded-[4px] bg-[var(--accent)] text-white font-medium text-[11px] transition-all"
          title="Toggle Top Ruler (T)" aria-pressed="true">{t('header.edge_top')}</button>
        <button id="edge-left-btn" data-edge="left"
          class="edge-btn h-7 px-2.5 flex items-center rounded-[4px] text-[var(--text-secondary)] hover:text-[var(--text-main)] font-medium text-[11px] transition-all"
          title="Toggle Left Ruler (L)" aria-pressed="false">{t('header.edge_left')}</button>
        <button id="edge-bottom-btn" data-edge="bottom"
          class="edge-btn h-7 px-2.5 flex items-center rounded-[4px] text-[var(--text-secondary)] hover:text-[var(--text-main)] font-medium text-[11px] transition-all"
          title="Toggle Bottom Ruler (B)" aria-pressed="false">{t('header.edge_bottom')}</button>
        <button id="edge-right-btn" data-edge="right"
          class="edge-btn h-7 px-2.5 flex items-center rounded-[4px] text-[var(--text-secondary)] hover:text-[var(--text-main)] font-medium text-[11px] transition-all"
          title="Toggle Right Ruler (R)" aria-pressed="false">{t('header.edge_right')}</button>
      </div>

      <div class="h-5 w-px bg-[var(--border-color)]"></div>

      <button id="toggle-floating-btn"
        class="h-7 px-2.5 flex items-center gap-1.5 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-secondary)] text-[11px] font-medium transition-all"
        title="Floating Ruler (M)" aria-pressed="false">
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="1.5" y="5.5" width="13" height="5" rx="1" transform="rotate(-10 8 8)"></rect>
          <line x1="4.5" y1="6.5" x2="5.5" y2="9.5"></line>
          <line x1="8" y1="6" x2="9" y2="10"></line>
          <line x1="11" y1="5.5" x2="12" y2="9"></line>
        </svg>
        <span>{t('header.floating')}</span>
      </button>

      <button id="toggle-calipers-btn"
        class="h-7 px-2.5 flex items-center gap-1.5 rounded-[6px] border border-[var(--accent-border)] bg-[var(--accent-light)] text-[var(--accent)] text-[11px] font-medium transition-all"
        title="Calipers (P)" aria-pressed="true">
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="2" x2="3" y2="14" stroke-linecap="round"></line>
          <line x1="13" y1="2" x2="13" y2="14" stroke-linecap="round"></line>
          <line x1="3" y1="8" x2="13" y2="8" stroke-dasharray="2 1.5"></line>
        </svg>
        <span>{t('header.calipers')}</span>
      </button>

      <button id="toggle-guides-btn"
        class="h-7 w-7 flex items-center justify-center rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-secondary)] transition-all"
        title="Guides (G)" aria-pressed="false">
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.5 2">
          <line x1="8" y1="1" x2="8" y2="15"></line>
          <line x1="1" y1="8" x2="15" y2="8"></line>
        </svg>
      </button>

      <button id="toggle-crosshair-btn"
        class="h-7 w-7 flex items-center justify-center rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-secondary)] transition-all"
        title="Crosshair (C)" aria-pressed="false">
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="8" cy="8" r="2.5"></circle>
          <line x1="8" y1="1" x2="8" y2="5"></line>
          <line x1="8" y1="11" x2="8" y2="15"></line>
          <line x1="1" y1="8" x2="5" y2="8"></line>
          <line x1="11" y1="8" x2="15" y2="8"></line>
        </svg>
      </button>
    </div>

    <!-- Right: Units + Calibrate + Utilities -->
    <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
      
      <!-- Unit Selector -->
      <div id="unit-selector" class="flex items-center rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] p-0.5" role="radiogroup" aria-label="Measurement Units">
        <button data-unit="in" class="unit-btn px-1.5 sm:px-2 h-7 rounded-[4px] text-[11px] font-semibold transition-all bg-[var(--accent)] text-white" role="radio" aria-checked="true" title="Inches">in</button>
        <button data-unit="cm" class="unit-btn px-1.5 sm:px-2 h-7 rounded-[4px] text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-main)] transition-all" role="radio" aria-checked="false" title="Centimeters">cm</button>
        <button data-unit="mm" class="unit-btn px-1.5 sm:px-2 h-7 rounded-[4px] text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-main)] transition-all" role="radio" aria-checked="false" title="Millimeters">mm</button>
        <button data-unit="px" class="unit-btn px-2 h-7 rounded-[4px] text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-main)] transition-all hidden lg:block" role="radio" aria-checked="false" title="Pixels">px</button>
      </div>

      <!-- Calibrate -->
      <button id="open-calibrate-btn"
        class="h-7 px-2 sm:px-2.5 flex items-center gap-1.5 rounded-[6px] border border-[var(--accent-border)] bg-[var(--accent-light)] hover:bg-[var(--accent)] hover:text-white text-[var(--accent)] text-[11px] font-medium transition-all shrink-0"
        title={t('header.calibrate')}
        aria-label={t('header.calibrate')}>
        <span id="cal-status-dot" class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse shrink-0"></span>
        <svg class="w-3.5 h-3.5 inline min-[480px]:hidden text-[var(--accent)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
        </svg>
        <span class="hidden min-[480px]:inline">{t('header.calibrate')}</span>
      </button>

      <!-- Compare (desktop only) -->
      <button id="open-objects-btn"
        class="h-7 px-2 hidden lg:flex items-center gap-1 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-secondary)] text-[11px] font-medium transition-all"
        title={t('header.compare')}
        aria-label={t('header.compare')}>
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="4" width="12" height="8" rx="1.5"></rect>
          <line x1="2" y1="7" x2="14" y2="7"></line>
        </svg>
        <span>{t('header.compare')}</span>
      </button>

      <!-- Shortcuts (hidden on mobile) -->
      <button id="open-shortcuts-btn"
        class="h-7 w-7 hidden md:flex items-center justify-center rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-secondary)] text-xs font-mono transition-all"
        title="Shortcuts (?)" aria-label="Keyboard Shortcuts">?</button>

      <!-- About Page Link (desktop) -->
      <a href={translatePath('/about')}
        class="h-7 px-2 hidden lg:flex items-center gap-1 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-secondary)] text-[11px] font-medium transition-all"
        title={t('header.about')}>
        <span>{t('header.about')}</span>
      </a>

      <!-- Language Selector -->
      <LanguagePicker variant="header" currentLang={currentLang} />

      <!-- Theme Toggle -->
      <button id="theme-toggle-btn"
        class="h-7 w-7 flex items-center justify-center rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-main)] transition-all shrink-0"
        title={t('header.theme')} aria-label={t('header.theme')}>
        <svg id="theme-sun-icon" class="w-3.5 h-3.5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg id="theme-moon-icon" class="w-3.5 h-3.5 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Fullscreen (desktop) -->
      <button id="fullscreen-toggle-btn"
        class="h-7 w-7 hidden sm:flex items-center justify-center rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:bg-[var(--accent-light)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] text-[var(--text-main)] transition-all shrink-0"
        title="Fullscreen (F)" aria-label="Toggle Fullscreen">
        <svg id="fs-enter-icon" class="w-3.5 h-3.5 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"></path>
        </svg>
        <svg id="fs-exit-icon" class="w-3.5 h-3.5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Controls Bar (< md) — NEVER OVERFLOWS, ALL BUTTONS FIT ON SCREEN -->
  <div id="mobile-controls-bar" class="md:hidden border-t border-[var(--border-color)] bg-[var(--bg-subtle)] px-2 py-1.5">
    <div class="flex items-center justify-between gap-1 w-full max-w-full">
      
      <!-- Left: Compact Edge Selector Segment (T | L | B | R) -->
      <div class="flex items-center rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] p-0.5 shrink-0" role="group" aria-label="Ruler Edges">
        <button data-edge="top" class="edge-btn h-7 px-2 rounded-[4px] bg-[var(--accent)] text-white text-[11px] font-semibold transition-all" title={t('header.edge_top')} aria-label={t('header.edge_top')} aria-pressed="true">T</button>
        <button data-edge="left" class="edge-btn h-7 px-2 rounded-[4px] text-[var(--text-secondary)] hover:text-[var(--text-main)] text-[11px] font-medium transition-all" title={t('header.edge_left')} aria-label={t('header.edge_left')} aria-pressed="false">L</button>
        <button data-edge="bottom" class="edge-btn h-7 px-2 rounded-[4px] text-[var(--text-secondary)] hover:text-[var(--text-main)] text-[11px] font-medium transition-all" title={t('header.edge_bottom')} aria-label={t('header.edge_bottom')} aria-pressed="false">B</button>
        <button data-edge="right" class="edge-btn h-7 px-2 rounded-[4px] text-[var(--text-secondary)] hover:text-[var(--text-main)] text-[11px] font-medium transition-all" title={t('header.edge_right')} aria-label={t('header.edge_right')} aria-pressed="false">R</button>
      </div>

      <!-- Right: Mobile Tools (Floating, Calipers, Compare, Fullscreen) -->
      <div class="flex items-center gap-1 shrink-0">
        
        <!-- Floating Ruler -->
        <button id="mobile-toggle-floating-btn"
          class="h-7 px-2 rounded-[6px] bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--accent)] hover:border-[var(--accent-border)] text-[11px] font-medium flex items-center gap-1 transition-all"
          title={t('header.floating')} aria-label={t('header.floating')} aria-pressed="false">
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="1.5" y="5.5" width="13" height="5" rx="1" transform="rotate(-10 8 8)"></rect>
            <line x1="5" y1="6.5" x2="6" y2="9.5"></line>
            <line x1="8.5" y1="6" x2="9.5" y2="10"></line>
          </svg>
          <span class="hidden min-[440px]:inline">{t('header.floating')}</span>
        </button>

        <!-- Calipers -->
        <button id="mobile-toggle-calipers-btn"
          class="h-7 px-2 rounded-[6px] bg-[var(--accent-light)] border border-[var(--accent-border)] text-[var(--accent)] text-[11px] font-medium flex items-center gap-1 transition-all"
          title={t('header.calipers')} aria-label={t('header.calipers')} aria-pressed="true">
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="3" y1="2" x2="3" y2="14" stroke-linecap="round"></line>
            <line x1="13" y1="2" x2="13" y2="14" stroke-linecap="round"></line>
            <line x1="3" y1="8" x2="13" y2="8" stroke-dasharray="2 1.5"></line>
          </svg>
          <span class="hidden min-[440px]:inline">{t('header.calipers')}</span>
        </button>

        <!-- Compare Objects -->
        <button id="mobile-open-objects-btn"
          class="h-7 w-7 rounded-[6px] bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--accent)] flex items-center justify-center transition-all shrink-0"
          title={t('header.compare')} aria-label={t('header.compare')}>
          <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="4" width="12" height="8" rx="1.5"></rect>
            <line x1="2" y1="7" x2="14" y2="7"></line>
          </svg>
        </button>

        <!-- Fullscreen -->
        <button id="mobile-fullscreen-btn"
          class="h-7 w-7 rounded-[6px] bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--accent)] flex items-center justify-center transition-all shrink-0"
          title="Toggle Fullscreen" aria-label="Toggle Fullscreen">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"></path>
          </svg>
        </button>

      </div>
    </div>
  </div>

</header>
