---
// SeoContent.astro - Comprehensive On-Page SEO Guide, Conversion Tables & FAQ
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import type { SupportedLang } from '../i18n/ui';

interface Props {
  lang?: SupportedLang;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<section id="guides-section" class="relative z-10 bg-[var(--bg-page)] border-t border-[var(--border-color)] pt-16 pb-24 overflow-hidden transition-colors duration-200">
  
  <!-- Subtle Hero Mesh Gradient Layer in background -->
  <div class="absolute top-0 left-0 right-0 h-96 hero-mesh-gradient pointer-events-none opacity-60 dark:opacity-40"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 space-y-16">
    
    <!-- Hero Title Band -->
    <div class="text-center space-y-3 pt-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-card)] shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="mono-eyebrow text-[10px] text-[var(--text-tertiary)] uppercase tracking-wider">{t('seo.badge')}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--text-main)] display-title">
        {t('seo.hero_title')}
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] max-w-2xl mx-auto leading-relaxed">
        {t('seo.hero_desc')}
      </p>

      <!-- Subpage Quick Links (Small Format) -->
      <nav class="flex flex-wrap items-center justify-center gap-2 pt-2" aria-label="Quick Page Navigation">
        <a href={translatePath('/about')} class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-medium border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-light)] hover:text-[var(--accent)] text-[var(--text-secondary)] transition-all shadow-xs group">
          <svg class="w-3 h-3 text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <span>{t('nav.about')}</span>
        </a>
        <a href={translatePath('/contact')} class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-medium border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-light)] hover:text-[var(--accent)] text-[var(--text-secondary)] transition-all shadow-xs group">
          <svg class="w-3 h-3 text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>{t('nav.contact')}</span>
        </a>
        <a href={translatePath('/privacy')} class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-medium border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-light)] hover:text-[var(--accent)] text-[var(--text-secondary)] transition-all shadow-xs group">
          <svg class="w-3 h-3 text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>{t('nav.privacy')}</span>
        </a>
        <a href={translatePath('/terms')} class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-medium border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-light)] hover:text-[var(--accent)] text-[var(--text-secondary)] transition-all shadow-xs group">
          <svg class="w-3 h-3 text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
          </svg>
          <span>{t('nav.terms')}</span>
        </a>
      </nav>
    </div>

    <!-- Feature Grid: 3 Hairline Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      
      <!-- Card 1 -->
      <div class="p-6 rounded-[12px] bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[var(--shadow-whisper)] space-y-2.5">
        <div class="w-8 h-8 rounded-[6px] bg-[#0070f3]/10 text-[#0070f3] flex items-center justify-center font-mono font-bold text-xs">
          01
        </div>
        <h3 class="text-sm font-semibold tracking-tight text-[var(--text-main)]">{t('seo.card1_title')}</h3>
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          {t('seo.card1_desc')}
        </p>
      </div>

      <!-- Card 2 -->
      <div class="p-6 rounded-[12px] bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[var(--shadow-whisper)] space-y-2.5">
        <div class="w-8 h-8 rounded-[6px] bg-[#7928ca]/10 text-[#7928ca] flex items-center justify-center font-mono font-bold text-xs">
          02
        </div>
        <h3 class="text-sm font-semibold tracking-tight text-[var(--text-main)]">{t('seo.card2_title')}</h3>
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          {t('seo.card2_desc')}
        </p>
      </div>

      <!-- Card 3 -->
      <div class="p-6 rounded-[12px] bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[var(--shadow-whisper)] space-y-2.5">
        <div class="w-8 h-8 rounded-[6px] bg-[#00dfd8]/10 text-[#00a8a2] dark:text-[#00dfd8] flex items-center justify-center font-mono font-bold text-xs">
          03
        </div>
        <h3 class="text-sm font-semibold tracking-tight text-[var(--text-main)]">{t('seo.card3_title')}</h3>
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          {t('seo.card3_desc')}
        </p>
      </div>

    </div>

    <!-- In-Depth 600+ Word Editorial Guide for SEO -->
    <article class="p-6 sm:p-10 rounded-[16px] bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[var(--shadow-whisper)] space-y-8 text-[var(--text-secondary)] text-sm leading-relaxed">
      
      <!-- Section 1 -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-main)]">
          What is an Actual Virtual Ruler and How Does It Work?
        </h2>
        <p>
          An <strong>actual virtual ruler</strong> is an interactive, browser-based physical measurement tool engineered to reproduce true-to-life dimensions on any digital display. When you place a screw, bolt, key, driver's license, or piece of jewelry directly against your glass screen, an <strong>accurate online ruler</strong> allows you to obtain exact physical measurements without needing a traditional wooden ruler or metal tape measure.
        </p>
        <p>
          The fundamental challenge with displaying an <strong>online ruler</strong> on modern digital screens is pixel density. Standard desktop web browsers operate under the legacy assumption that one inch equals exactly 96 CSS pixels. However, modern displays vary wildly: a 24-inch 1080p desktop monitor has approximately 91 physical pixels per inch (PPI), a 14-inch MacBook Pro Retina screen features over 250 PPI, and modern smartphones pack anywhere from 320 to 460 PPI. If a website draws a ruler with uncalibrated CSS pixels, the resulting scale can be distorted by 30% to 50%.
        </p>
        <p>
          FreeVirtualRuler.com solves this problem by recalculating your hardware's exact pixel pitch. By pairing your browser's <code class="px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] text-[var(--text-main)] font-mono text-xs">window.devicePixelRatio</code> with our database of verified display resolutions or your screen's advertised diagonal size, this <strong>free online ruler</strong> delivers an exact 1:1 physical ratio.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-main)]">
          Full Size Virtual Ruler in Inches, Centimeters, and Millimeters
        </h2>
        <p>
          Our <strong>full size virtual ruler</strong> supports both the Imperial measurement system and the International System of Units (Metric), giving you the flexibility to measure in whatever units your project requires:
        </p>
        <ul class="list-disc list-inside space-y-2 pl-2">
          <li>
            <strong>Virtual Ruler Inches:</strong> Displays true fractional markings down to 1/16th and 1/32nd of an inch. Essential for woodworking, construction, home DIY, crafting, and mechanical assembly where <strong>online ruler inches</strong> are the industry standard.
          </li>
          <li>
            <strong>Online Ruler in cm & Online Ruler cm:</strong> Provides clear centimeter graduations with bold numbered markers and distinct half-centimeter subdividers, perfect for international shipping, tailoring, package dimensioning, and everyday household measurement.
          </li>
          <li>
            <strong>Online Ruler mm & Virtual Ruler mm:</strong> Engineered for scientific analysis, 3D printing calibration, jewelry sizing, and electronic component inspection where millimeter-level accuracy is mandatory.
          </li>
        </ul>
        <p>
          You can toggle instantly between inches, centimeters, millimeters, and raw screen pixels using the toolbar unit selector or quick keyboard shortcuts (<kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border-color)] font-mono text-xs">1</kbd> for inches, <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border-color)] font-mono text-xs">2</kbd> for cm, <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border-color)] font-mono text-xs">3</kbd> for mm, and <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border-color)] font-mono text-xs">4</kbd> for pixels).
        </p>
      </section>

      <!-- Section 3 -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-main)]">
          Measuring Tape Full Size Virtual Ruler with Precision Dual Calipers
        </h2>
        <p>
          Trying to hold an object against the edge of a monitor while squinting at tick marks can be awkward. That is why this tool incorporates a digital <strong>measuring tape full size virtual ruler</strong> equipped with interactive dual calipers (Point A and Point B).
        </p>
        <p>
          Simply rest your physical object flat on your screen and drag Caliper Line A to its starting boundary and Caliper Line B to its ending boundary. As you slide either point, the floating measurement HUD continuously updates with sub-millimeter precision. For imperial measurements, the caliper displays both the common fractional representation (such as <span class="font-mono font-semibold text-[var(--text-main)]">2 3/8"</span>) and the exact decimal equivalent (<span class="font-mono font-semibold text-[var(--text-main)]">2.375 in / 60.3 mm</span>). A built-in one-click <em>Copy</em> button lets you instantly paste exact dimensions into your CAD drawings, order forms, or spreadsheet notes.
        </p>
      </section>

      <!-- Section 4 -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-main)]">
          12 Inch Online Ruler Across Any Desktop or Laptop Screen
        </h2>
        <p>
          On standard 13-inch, 15-inch, 17-inch laptops and larger external desktop monitors (24", 27", 32"), our horizontal top and bottom rulers extend across the full width of your display. This provides an instant <strong>12 inch online ruler</strong> (or <strong>online ruler 12 inch</strong>) right along your monitor bezel.
        </p>
        <p>
          Need to measure something diagonally or away from the edges? Activate our <strong>Floating Ruler Stick</strong>. You can drag this virtual stick anywhere across the canvas, rotate it freely to any angle from 0° to 360°, and extend or shorten its length to fit any item. On mobile devices, a dedicated bottom control dock allows you to fine-tune rotation by 1-degree increments, reset to level zero, or expand length without your fingers blocking the ruler.
        </p>
      </section>

      <!-- Section 5 -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-main)]">
          Instant Mobile Ruler & Virtual Ruler App Without Downloads
        </h2>
        <p>
          Why waste storage space and battery downloading a standalone <strong>virtual ruler app</strong> from the App Store or Google Play? Most native ruler apps are laden with pop-up advertisements, subscription paywalls, and invasive tracking permissions.
        </p>
        <p>
          FreeVirtualRuler.com serves as a frictionless, high-speed <strong>mobile ruler</strong> directly in Safari, Chrome, Samsung Internet, or Firefox. It requires zero installations, zero app store downloads, and zero user registrations. The layout is optimized specifically for mobile touchscreens with responsive touch grips, zero horizontal clipping, and high-DPI canvas rendering. It even remembers your calibrated display profile in your device's local storage so it is immediately ready to measure every time you return.
        </p>
      </section>

      <!-- Section 6 -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-main)]">
          How to Calibrate for 100% Accuracy
        </h2>
        <p>
          Achieving flawless physical accuracy takes only seconds through our four built-in calibration methods:
        </p>
        <ol class="list-decimal list-inside space-y-2 pl-2">
          <li>
            <strong>Auto-Detect Device:</strong> Automatically inspects your screen resolution, device pixel ratio, and user-agent string to match factory profiles for popular Apple MacBooks, iPads, iPhones, Dell XPS laptops, Samsung Galaxy devices, and standard Full HD displays.
          </li>
          <li>
            <strong>Screen Diagonal Size:</strong> Enter your monitor's diagonal screen size in inches (such as 13.3", 15.6", 24", or 27"). The calculator uses the Pythagorean theorem to derive your exact CSS PPI.
          </li>
          <li>
            <strong>Standard Credit Card Calibration:</strong> Place any standard credit card, debit card, or driver's license (which globally adhere to the ISO/IEC 7810 ID-1 standard of exactly 3.370 inches or 85.60 mm wide) over the on-screen card guide and adjust the slider until they match perfectly.
          </li>
          <li>
            <strong>Manual PPI Entry:</strong> If you know your manufacturer's advertised pixel density specification, enter it directly for instant sub-pixel calibration.
          </li>
        </ol>
      </section>

    </article>

    <!-- Calibration Deep-Dive: Method 1 & Method 2 Cards -->
    <div class="p-6 sm:p-8 rounded-[16px] bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[var(--shadow-whisper)] space-y-6">
      <div>
        <div class="mono-eyebrow text-[11px] text-[var(--text-tertiary)] mb-1">Calibration Science</div>
        <h2 class="text-xl font-semibold tracking-tight text-[var(--text-main)] heading-section">
          Why Calibration Matters for an Accurate Online Ruler
        </h2>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
        <p>
          Every computer display and smartphone panel has a unique physical pixel density, measured in <strong>Pixels Per Inch (PPI)</strong>. A 13.3-inch laptop at 1080p has roughly 166 PPI, whereas a 27-inch 1080p desktop monitor has only 82 PPI. Without adjusting for pixel density, a virtual ruler cannot guarantee real physical accuracy.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div class="p-4 rounded-[8px] bg-[var(--bg-subtle)] border border-[var(--border-color)] space-y-2">
            <h4 class="text-xs font-semibold text-[var(--text-main)] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3]"></span>
              Method 1: Auto-Detect Hardware
            </h4>
            <p class="text-xs text-[var(--text-secondary)]">
              Automatically inspects your browser environment (<span class="font-mono">window.screen</span>, <span class="font-mono">devicePixelRatio</span>, user-agent) and matches it against our built-in database of Apple, Samsung, Google, and standard laptop panels.
            </p>
          </div>

          <div class="p-4 rounded-[8px] bg-[var(--bg-subtle)] border border-[var(--border-color)] space-y-2">
            <h4 class="text-xs font-semibold text-[var(--text-main)] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#7928ca]"></span>
              Method 2: Screen Diagonal (Pythagoras)
            </h4>
            <p class="text-xs text-[var(--text-secondary)]">
              Input your monitor's advertised diagonal size in inches (e.g. 14", 15.6", 24", 27"). The calculator calculates:
              <span class="block font-mono text-[11px] text-[var(--text-main)] mt-1">CSS PPI = √(Width² + Height²) / Diagonal</span>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Fractional Inches Quick Reference Chart -->
    <div class="space-y-4">
      <div>
        <div class="mono-eyebrow text-[11px] text-[var(--text-tertiary)] mb-1">Imperial Conversion</div>
        <h2 class="text-xl font-semibold tracking-tight text-[var(--text-main)] heading-section">
          Inches to Metric Conversion & Fractional Table
        </h2>
      </div>

      <div class="rounded-[12px] border border-[var(--border-color)] bg-[var(--bg-card)] overflow-hidden shadow-[var(--shadow-whisper)]">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead class="bg-[var(--bg-subtle)] border-b border-[var(--border-color)] text-[var(--text-tertiary)] uppercase text-[10px]">
              <tr>
                <th class="p-3 px-4">Fraction (in)</th>
                <th class="p-3 px-4">Decimal (in)</th>
                <th class="p-3 px-4">Millimeters (mm)</th>
                <th class="p-3 px-4">Centimeters (cm)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-color)] text-[var(--text-main)]">
              <tr class="hover:bg-[var(--bg-subtle)]/50 transition-colors">
                <td class="p-3 px-4 font-semibold text-[#0070f3]">1/16"</td>
                <td class="p-3 px-4">0.0625"</td>
                <td class="p-3 px-4">1.588 mm</td>
                <td class="p-3 px-4">0.159 cm</td>
              </tr>
              <tr class="hover:bg-[var(--bg-subtle)]/50 transition-colors">
                <td class="p-3 px-4 font-semibold text-[#0070f3]">1/8"</td>
                <td class="p-3 px-4">0.1250"</td>
                <td class="p-3 px-4">3.175 mm</td>
                <td class="p-3 px-4">0.318 cm</td>
              </tr>
              <tr class="hover:bg-[var(--bg-subtle)]/50 transition-colors">
                <td class="p-3 px-4 font-semibold text-[#0070f3]">1/4"</td>
                <td class="p-3 px-4">0.2500"</td>
                <td class="p-3 px-4">6.350 mm</td>
                <td class="p-3 px-4">0.635 cm</td>
              </tr>
              <tr class="hover:bg-[var(--bg-subtle)]/50 transition-colors">
                <td class="p-3 px-4 font-semibold text-[#0070f3]">3/8"</td>
                <td class="p-3 px-4">0.3750"</td>
                <td class="p-3 px-4">9.525 mm</td>
                <td class="p-3 px-4">0.953 cm</td>
              </tr>
              <tr class="hover:bg-[var(--bg-subtle)]/50 transition-colors">
                <td class="p-3 px-4 font-semibold text-[#0070f3]">1/2"</td>
                <td class="p-3 px-4">0.5000"</td>
                <td class="p-3 px-4">12.700 mm</td>
                <td class="p-3 px-4">1.270 cm</td>
              </tr>
              <tr class="hover:bg-[var(--bg-subtle)]/50 transition-colors">
                <td class="p-3 px-4 font-semibold text-[#0070f3]">3/4"</td>
                <td class="p-3 px-4">0.7500"</td>
                <td class="p-3 px-4">19.050 mm</td>
                <td class="p-3 px-4">1.905 cm</td>
              </tr>
              <tr class="hover:bg-[var(--bg-subtle)]/50 transition-colors bg-[var(--bg-subtle)]/30 font-semibold">
                <td class="p-3 px-4 text-[#0070f3]">1" (One Inch)</td>
                <td class="p-3 px-4">1.0000"</td>
                <td class="p-3 px-4">25.400 mm</td>
                <td class="p-3 px-4">2.540 cm</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Frequently Asked Questions (Accordion with JSON-LD FAQPage Schema) -->
    <div id="faq" class="space-y-6">
      <div class="space-y-1">
        <div class="mono-eyebrow text-[11px] text-[var(--text-tertiary)] mb-1">Help & Knowledge Base</div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-main)] heading-section">
          Frequently Asked Questions
        </h2>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)]">
          Everything you need to know about using a virtual ruler, phone measurement, calibration, and accuracy.
        </p>
      </div>

      <div class="space-y-2.5">
        
        <!-- FAQ 1 -->
        <details class="group rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] transition-all">
          <summary class="flex items-center justify-between p-4 cursor-pointer text-xs sm:text-sm font-semibold text-[var(--text-main)] select-none">
            <span>Can I use my phone as a ruler?</span>
            <svg class="w-4 h-4 text-[var(--text-tertiary)] group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="px-4 pb-4 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed border-t border-[var(--border-color)] pt-3">
            Yes, you can easily use your phone as a physical ruler by visiting FreeVirtualRuler.com in any mobile browser. Our virtual ruler automatically adapts to your smartphone's screen size and pixel density (PPI), giving you an actual-size ruler in inches and centimeters directly on your screen without installing an app.
          </div>
        </details>

        <!-- FAQ 2 -->
        <details class="group rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] transition-all">
          <summary class="flex items-center justify-between p-4 cursor-pointer text-xs sm:text-sm font-semibold text-[var(--text-main)] select-none">
            <span>Is there a virtual ruler?</span>
            <svg class="w-4 h-4 text-[var(--text-tertiary)] group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="px-4 pb-4 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed border-t border-[var(--border-color)] pt-3">
            Yes! FreeVirtualRuler.com is a 100% free, browser-based virtual ruler that displays actual-size physical measurements on any smartphone, tablet, laptop, or desktop monitor. It includes edge-flush rulers, movable floating rulers, and dual calipers with 1/16" and 1/32" precision.
          </div>
        </details>

        <!-- FAQ 3 -->
        <details class="group rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] transition-all">
          <summary class="flex items-center justify-between p-4 cursor-pointer text-xs sm:text-sm font-semibold text-[var(--text-main)] select-none">
            <span>Is there a free online tape measure available?</span>
            <svg class="w-4 h-4 text-[var(--text-tertiary)] group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
