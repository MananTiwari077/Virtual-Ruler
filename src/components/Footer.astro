---
// Footer.astro - Clean Vercel Geist aesthetic footer
---

<footer class="relative z-10 bg-[var(--bg-page)] border-t border-[var(--border-color)] py-12 transition-colors duration-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-[var(--text-main)]">
        <div class="w-5 h-5 rounded-[4px] bg-[var(--text-main)] text-[var(--bg-card)] flex items-center justify-center font-mono font-bold text-[10px]">
          R
        </div>
        <span class="font-semibold text-xs tracking-tight">Free Virtual Ruler</span>
      </div>

      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-[var(--text-secondary)]">
        <a href="#ruler-workspace" class="hover:text-[var(--text-main)] transition-colors">Virtual Ruler</a>
        <a href="#guides-section" class="hover:text-[var(--text-main)] transition-colors">Calibration Guide</a>
        <a href="#guides-section" class="hover:text-[var(--text-main)] transition-colors">Conversion Chart</a>
        <a href="#guides-section" class="hover:text-[var(--text-main)] transition-colors">FAQ</a>
      </nav>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-4 border-t border-[var(--border-color)] text-[11px] text-[var(--text-tertiary)] font-mono">
      <p>&copy; {new Date().getFullYear()} Free Virtual Ruler (freevirtualruler.com). Accurate on-screen measurement tool.</p>
      <div class="flex gap-4">
        <span>No app required</span>
        <span>·</span>
        <span>Privacy-first</span>
        <span>·</span>
        <span>Inches & Metric</span>
      </div>
    </div>
  </div>
</footer>
